# Copia este fichero como .env y ajusta los valores de cada implementación.

# Nombre que devuelve la API (informativo).
APP_NAME="Observatorio de proyectos"

# development | production
ENVIRONMENT=development

# Conexión a la base de datos. Por defecto, un fichero SQLite en data/.
DATABASE_URL=sqlite:///data/observatorio.db

# Orígenes del frontend autorizados (separados por comas).
CORS_ORIGINS=http://localhost:5173

# Roles de usuario (separados por comas) y rol que lo ve todo.
# Deben coincidir con frontend/src/config/roles.js.
ROLES=administracion,gestion,politico
SUPER_ROLE=administracion

# Cookie de sesión.
SESSION_COOKIE_NAME=observatorio_session
SESSION_HOURS=12
# true en producción (solo HTTPS). false en desarrollo con http://localhost.
COOKIE_SECURE=false